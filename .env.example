# Supabase (Settings > API). La clé service_role reste côté serveur uniquement.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe de l'espace artisan (/atelier).
ATELIER_PASSWORD=

# Une image est archivée pour l'accéléré toutes les N secondes (défaut 10).
ARCHIVE_EVERY_SECONDS=10
